{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the Fear AI Tester",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-create-directory",
    "fs:allow-read-directory",
    "fs:scope-appdata",
    "fs:scope-appdata-recursive",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA/**" }, { "path": "$HOME/exports/**" }]
    }
  ]
}
